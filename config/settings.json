{
  "system": {
    "language": "ru",
    "hotkeys": {
      "toggle_spotlight": "alt+space",
      "push_to_talk": "caps_lock",
      "emergency_kill_switch": "escape"
    },
    "mouse_failsafe": {
      "shake_detection": true,
      "shake_threshold_pixels": 400
    }
  },
  "audio": {
    "sample_rate": 16000,
    "vad_threshold": 0.5,
    "silence_duration_ms": 600,
    "ducking_enabled": true
  },
  "models": {
    "stt": {
      "engine": "faster-whisper",
      "model_size": "small",
      "device": "cpu",
      "compute_type": "int8"
    },
    "tts": {
      "engine": "piper",
      "model_name": "ru_RU-dmitri-medium",
      "device": "cpu"
    },
    "llm": {
      "engine": "llama-cpp",
      "model_name": "Qwen2.5-VL-3B-Instruct-Q4_K_M.gguf",
      "n_gpu_layers": 99,
      "context_window": 4096
    }
  }
}
